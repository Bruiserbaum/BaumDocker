# Workspace = ~/Projects (BaumAI, BaumAgent, BaumDocker, baumagent-clients,
# ai-env). Change only if you want a different folder mounted as the
# browser IDE's workspace root.
CODE_SERVER_WORKSPACE=/home/bruiserbaum/Projects

# code-server's own login (defense-in-depth behind Authentik's forward-auth
# — see ../authentik/snippets/code-server-npm-forward-auth.conf). Generate
# with: openssl rand -base64 24
CODE_SERVER_PASSWORD=

# Host port for direct LAN access (before NPM/Authentik are wired up, or
# for local testing). NPM will proxy code.baumwire.com -> this port.
# CODE_SERVER_PORT=8090

PUID=1000
PGID=1000
TZ=America/Chicago

# Must match what `docker network ls` shows (ai-stack's compose project
# prefix). Already confirmed as ai-stack_ai_frontend / ai-stack_ai_backend
# on this box.
# AISTACK_FRONTEND_NET=ai-stack_ai_frontend
# AISTACK_BACKEND_NET=ai-stack_ai_backend
